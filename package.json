{
  "name": "teach-utov",
  "productName": "Teach_UtoV",
  "version": "0.2.0",
  "description": "수업에서 보여줄 유튜브 영상의 구간을 기록해 두고 클릭 한 번으로 재생하는 도구",
  "license": "MIT",
  "author": {
    "name": "Teach_UtoV"
  },
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "dev": "node scripts/serve.mjs",
    "app": "electron .",
    "icon": "node scripts/make-icon.mjs",
    "dist": "electron-builder --win portable nsis",
    "dist:portable": "electron-builder --win portable",
    "site": "node scripts/serve-site.mjs"
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "kr.teachutov.app",
    "productName": "Teach_UtoV",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "scripts/static-server.mjs",
      "docs/app/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "Teach_UtoV-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Teach_UtoV",
      "artifactName": "Teach_UtoV-setup.exe"
    },
    "compression": "maximum"
  }
}
